+package nandorojo.modules.galeria
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.BitmapRegionDecoder
+import android.graphics.Rect
+import android.net.Uri
+import com.bumptech.glide.Glide
+import java.io.File
+import java.security.MessageDigest
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.Executors
+import kotlin.math.roundToInt
+
+/**
+ * Cuts the top of a very long image at the resolution it is shown at. Drawing the whole image
+ * instead would need a bitmap taller than the GPU can upload, so it gets squeezed and blurs.
+ * The download goes through Glide, so the viewer later opens the same file without refetching.
+ */
+object LongImageCrop {
+    private const val CACHE_DIR = "galeria-long-images"
+    private const val JPEG_QUALITY = 92
+    private const val THREADS = 2
+
+    /**
+     * Crops block on the download, so they run here rather than on the Expo modules queue,
+     * which is a single thread shared with every other module's async calls.
+     */
+    val executor: ExecutorService by lazy {
+        Executors.newFixedThreadPool(THREADS) { task ->
+            Thread(task, "galeria-long-image").apply { isDaemon = true }
+        }
+    }
+
+    /** Blocking; call off the main thread. Returns null when the file is not a decodable image. */
+    fun crop(context: Context, url: String, maxAspect: Double, targetWidth: Int): Map<String, Any>? {
+        val dir = File(context.cacheDir, CACHE_DIR).apply { mkdirs() }
+        val out = File(dir, "${digest("$url|$maxAspect|$targetWidth")}.jpg")
+        // The size file is renamed into place before the image, so an existing image always
+        // has a complete size file next to it.
+        val metaFile = File(dir, "${out.name}.size")
+        if (out.exists()) {
+            val size = metaFile.takeIf { it.exists() }?.readText()?.split('x')?.mapNotNull { it.toIntOrNull() }
+            if (size?.size == 2) return result(out, size[0], size[1])
+        }
+
+        val source = Glide.with(context.applicationContext).downloadOnly().load(url).submit().get()
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(source.absolutePath, bounds)
+        val width = bounds.outWidth
+        val height = bounds.outHeight
+        if (width <= 0 || height <= 0) return null
+
+        val cropHeight = minOf(height, (width * maxAspect).roundToInt())
+        var sampleSize = 1
+        while (width / (sampleSize * 2) >= targetWidth) sampleSize *= 2
+        val decoder = BitmapRegionDecoder.newInstance(source.absolutePath) ?: return null
+        val bitmap: Bitmap = try {
+            decoder.decodeRegion(
+                Rect(0, 0, width, cropHeight),
+                BitmapFactory.Options().apply { inSampleSize = sampleSize },
+            ) ?: return null
+        } finally {
+            decoder.recycle()
+        }
+        // Two calls for the same image can run at once, so each writes its own temporary files;
+        // renames replace atomically and both write the same bytes.
+        val partialImage = File.createTempFile(out.name, ".part", dir)
+        val partialMeta = File.createTempFile(metaFile.name, ".part", dir)
+        try {
+            val written = try {
+                partialImage.outputStream().use { bitmap.compress(Bitmap.CompressFormat.JPEG, JPEG_QUALITY, it) }
+            } finally {
+                bitmap.recycle()
+            }
+            if (!written) return null
+            partialMeta.writeText("${width}x$height")
+            if (!partialMeta.renameTo(metaFile) || !partialImage.renameTo(out)) return null
+        } finally {
+            partialImage.delete()
+            partialMeta.delete()
+        }
+        return result(out, width, height)
+    }
+
+    /** `width`/`height` describe the whole image; the file holds only its top. */
+    private fun result(file: File, width: Int, height: Int): Map<String, Any> {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.absolutePath, bounds)
+        return mapOf(
+            "uri" to Uri.fromFile(file).toString(),
+            "cropWidth" to bounds.outWidth,
+            "cropHeight" to bounds.outHeight,
+            "width" to width,
+            "height" to height,
+        )
+    }
+
+    private fun digest(value: String): String =
+        MessageDigest.getInstance("SHA-1").digest(value.toByteArray()).joinToString("") { "%02x".format(it) }
+}
